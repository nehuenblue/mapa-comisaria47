// ============================================================
// Firebase Storage Security Rules — Comisaría N° 47
// ----------------------------------------------------------------
// Las fotos de personas son accesibles SOLO a usuarios autenticados
// y activos. El acceso público está bloqueado.
// ============================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function userExists() {
      return firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function isActive() {
      return isSignedIn() && userExists() && userDoc().activo == true;
    }

    function role() { return userDoc().rol; }
    function isAdmin()      { return isActive() && role() == 'admin'; }
    function isSupervisor() { return isActive() && (role() == 'admin' || role() == 'supervisor'); }
    function isOperador()   { return isActive() && (role() == 'admin' || role() == 'supervisor' || role() == 'operador'); }

    // Validar que el contenido subido es imagen y pesa ≤ 2 MB
    function validImage() {
      return request.resource.size <= 2 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    // ====================================================
    // FOTOS DE PERSONAS
    // ----------------------------------------------------
    // Lectura: cualquier usuario activo.
    // Escritura: operador o superior.
    // Borrado: solo admin.
    // ====================================================
    match /fotos_personas/{file} {
      allow read: if isActive();
      allow create, update: if isOperador() && validImage();
      allow delete: if isAdmin();
    }

    // ====================================================
    // BACKUPS (uso futuro)
    // ====================================================
    match /backups/{path=**} {
      allow read, write: if isAdmin();
    }

    // ====================================================
    // Resto: denegado
    // ====================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
