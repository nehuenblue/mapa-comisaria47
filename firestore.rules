// ============================================================
// Firestore Security Rules — Comisaría N° 47 (v3 — Fase 3)
// ------------------------------------------------------------
// Cambios respecto a v2:
//  - Supervisor puede crear / editar / borrar incidentes y personas
//  - Supervisor puede subir / borrar fotos en Storage
//  - Supervisor NO puede crear / editar / desactivar usuarios
//  - Supervisor NO puede modificar rol de nadie
//  - Solo admin gestiona: usuarios, configuracion
//  - Auditoria + historico: append-only (nadie modifica/borra registros)
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
        : {};
    }

    function userRole()   { return userData().get('rol', ''); }
    function userActive() { return userData().get('activo', false) == true; }

    function isActive()       { return isSignedIn() && userActive(); }
    function isAdmin()        { return isActive() && userRole() == 'admin'; }
    function isSupervisor()   { return isActive() && (userRole() == 'admin' || userRole() == 'supervisor'); }
    function isOperador()     { return isActive() && (userRole() == 'admin' || userRole() == 'supervisor' || userRole() == 'operador'); }
    function isLectura()      { return isActive(); }

    function isOwner(resource) {
      return isSignedIn() && resource.data.operadorUid == request.auth.uid;
    }
    function isFinalized(resource) {
      return resource.data.estado == 'Finalizado';
    }

    // USUARIOS — solo admin
    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // INCIDENTES
    match /incidentes/{id} {
      allow read: if isLectura();
      allow create: if isOperador()
                    && request.resource.data.operadorUid == request.auth.uid;
      allow update: if (isOwner(resource) && !isFinalized(resource) && isOperador())
                    || isSupervisor();
      allow delete: if isSupervisor();
    }

    // PERSONAS (4 módulos)
    match /personas/{id} {
      allow read: if isLectura();
      allow create: if isOperador()
                    && request.resource.data.operadorUid == request.auth.uid;
      allow update: if (isOwner(resource) && isOperador())
                    || isSupervisor();
      allow delete: if isSupervisor();
    }

    // AUDITORIA — append only
    match /auditoria/{id} {
      allow read: if isSupervisor();
      allow create: if isActive();
      allow update, delete: if false;
    }

    // HISTORICO — permanente
    match /historico/{id} {
      allow read: if isSupervisor();
      allow create: if isSupervisor();
      allow update, delete: if false;
    }

    // CONFIGURACION — solo admin
    match /configuracion/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // EXPORTACIONES — registro opcional
    match /exportaciones/{id} {
      allow read: if isSupervisor();
      allow create: if isActive();
      allow update, delete: if false;
    }
  }
}
