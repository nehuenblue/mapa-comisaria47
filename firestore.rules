// ============================================================
// Firestore Security Rules — Comisaría N° 47 (v4 — Fase 7)
// ============================================================
//  - Todos los roles activos pueden modificar TODO (excepto usuarios)
//  - Solo admin gestiona usuarios
//  - Auditoria + historico: append-only
//  - Nuevas colecciones: denuncias, exposiciones
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function userData() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
        : {};
    }

    function userRole()   { return userData().get('rol', ''); }
    function userActive() { return userData().get('activo', false) == true; }

    function isActive()       { return isSignedIn() && userActive(); }
    function isAdmin()        { return isActive() && userRole() == 'admin'; }
    function isSupervisor()   { return isActive() && (userRole() == 'admin' || userRole() == 'supervisor'); }
    function isOperador()     { return isActive() && (userRole() == 'admin' || userRole() == 'supervisor' || userRole() == 'operador'); }
    function isLectura()      { return isActive(); }

    // USUARIOS — solo admin
    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // INCIDENTES
    match /incidentes/{id} {
      allow read: if isLectura();
      allow create: if isOperador()
                    && request.resource.data.operadorUid == request.auth.uid;
      allow update: if isOperador();
      allow delete: if isSupervisor();
    }

    // PERSONAS
    match /personas/{id} {
      allow read: if isLectura();
      allow create: if isOperador()
                    && request.resource.data.operadorUid == request.auth.uid;
      allow update: if isOperador();
      allow delete: if isSupervisor();
    }

    // DENUNCIAS (nueva)
    match /denuncias/{id} {
      allow read: if isLectura();
      allow create: if isOperador()
                    && request.resource.data.operadorUid == request.auth.uid;
      allow update: if isOperador();
      allow delete: if isSupervisor();
    }

    // EXPOSICIONES (nueva)
    match /exposiciones/{id} {
      allow read: if isLectura();
      allow create: if isOperador()
                    && request.resource.data.operadorUid == request.auth.uid;
      allow update: if isOperador();
      allow delete: if isSupervisor();
    }

    // AUDITORIA
    match /auditoria/{id} {
      allow read: if isSupervisor();
      allow create: if isActive();
      allow update, delete: if false;
    }

    // HISTORICO permanente
    match /historico/{id} {
      allow read: if isSupervisor();
      allow create: if isSupervisor();
      allow update, delete: if false;
    }

    match /configuracion/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /exportaciones/{id} {
      allow read: if isSupervisor();
      allow create: if isActive();
      allow update, delete: if false;
    }
  }
}
